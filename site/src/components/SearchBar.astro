---
import Search from 'astro-pagefind/components/Search.astro';

interface Props {
  placeholder?: string;
}

const { placeholder = 'Search documentation...' } = Astro.props;
---

<div class="search-bar">
  <Search
    instance="docs-search"
    className="pagefind-ui"
    searchboxOptions={{
      placeholder,
      'show-sub-results': true,
    }}
    configOptions={{
      'show-images': false,
    }}
  />
</div>

<style>
  .search-bar {
    margin-bottom: 1.5rem;

    /* Theme the Pagefind Component UI for the site's dark palette.
       Pagefind 1.5 exposes these on :root; scoping them here keeps the
       override local to the search widget. */
    --pf-font: var(--font-sans);
    --pf-text: var(--color-fg);
    --pf-text-secondary: var(--color-fg-muted);
    --pf-text-muted: var(--color-fg-dim);
    --pf-background: var(--color-bg-soft);
    --pf-border: var(--color-border);
    --pf-border-focus: var(--color-accent-bright);
    --pf-border-radius: 0.5rem;
    --pf-hover: var(--color-bg-card);
    --pf-mark: var(--color-accent-bright);
    --pf-skeleton: var(--color-bg-card);
    --pf-skeleton-shine: var(--color-bg-soft);
    --pf-scroll-shadow: oklch(0 0 0 / 0.35);
    --pf-outline-focus: var(--color-accent-bright);
    --pf-modal-backdrop: oklch(0 0 0 / 0.6);

    --pf-input-font-size: 0.875rem;
    --pf-summary-font-size: 0.8125rem;
    --pf-result-title-font-size: 0.875rem;
    --pf-result-excerpt-font-size: 0.8125rem;

    --pf-shadow-sm: 0 2px 8px oklch(0 0 0 / 0.35);
    --pf-shadow-md: 0 4px 12px oklch(0 0 0 / 0.45);
    --pf-shadow-lg: 0 16px 48px oklch(0 0 0 / 0.6);
  }

  .search-bar :global(pagefind-searchbox) {
    display: block;
  }
</style>
