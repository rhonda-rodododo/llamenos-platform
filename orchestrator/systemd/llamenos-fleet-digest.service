# orchestrator/systemd/llamenos-fleet-digest.service
[Unit]
Description=Llámenos fleet — digest and notification
After=network-online.target

[Service]
Type=oneshot
# %h is the unit owner's home directory (these are systemd USER units). There is
# deliberately no WorkingDirectory=: the wrapper installed at
# %h/.local/bin/llamenos-fleet is a symlink into the repo checkout and cd's there
# itself (see orchestrator/bin/llamenos-fleet), so the checkout can live anywhere.
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.llamenos-fleet/env
ExecStart=%h/.local/bin/llamenos-fleet digest
# A digest run does its own best-effort notification internally (notify.ts) and
# must never fail the unit because a webhook or command sink was unreachable —
# see notify.ts: sink failures are caught and reported inside NotifyResult,
# never thrown. This unit only fails on an actual digest-rendering error.
SuccessExitStatus=0
TimeoutStartSec=300
