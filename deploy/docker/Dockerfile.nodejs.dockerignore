# BuildKit uses this file instead of the root .dockerignore when building
# with `-f deploy/docker/Dockerfile.nodejs` (BuildKit convention:
# <dockerfile>.dockerignore takes precedence over the root .dockerignore).
#
# The root .dockerignore excludes deploy/ wholesale (with a couple of
# allowlisted exceptions for the Bun Dockerfile), which also hid
# deploy/docker/docker-entrypoint-nodejs.sh from this Dockerfile's build
# context. Mirror the root ignore list here, but allowlist the nodejs
# entrypoint too.
node_modules
dist
.git
packages/crypto/target
.wrangler
.dev.vars
*.log
tests
site
!site/package.json
docs
.playwright
data
deploy
!deploy/docker/download-page
!deploy/docker/docker-entrypoint-nodejs.sh
CHANGELOG.md
