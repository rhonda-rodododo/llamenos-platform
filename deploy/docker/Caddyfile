{$DOMAIN:localhost} {
	# API, telephony, and messaging routes → app
	handle /api/* {
		reverse_proxy app:3000
	}

	handle /telephony/* {
		reverse_proxy app:3000
	}

	handle /messaging/* {
		reverse_proxy app:3000
	}

	# WebSocket relay → app (same server, /ws path)
	handle /ws {
		reverse_proxy app:3000
	}

	# Everything else → app (serves download page for browsers, API for desktop clients)
	handle {
		reverse_proxy app:3000
	}

	# Security headers
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Permitted-Cross-Domain-Policies "none"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://{$DOMAIN:localhost}/ws; media-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		-Server
	}

	encode gzip zstd

	# JSON access logging for structured log aggregation (Loki, ELK, CloudWatch)
	log {
		output stdout
		format json
		level INFO
	}

	# Rate limiting: requires caddy-rate-limit plugin (not in default Caddy image).
	# To enable, build a custom Caddy image with:
	#   xcaddy build --with github.com/mholt/caddy-ratelimit
	# Then add:
	#   rate_limit {remote.ip} 100r/m
}
