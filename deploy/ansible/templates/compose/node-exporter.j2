name: llamenos-node-exporter

services:
  node-exporter:
    image: {{ node_exporter_image | default('prom/node-exporter:v1.9.0') }}
    restart: unless-stopped
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    command:
      - '--path.procfs=/host/proc'
      - '--path.rootfs=/rootfs'
      - '--path.sysfs=/host/sys'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
    networks:
      - llamenos-observability
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  llamenos-observability:
    external: true
