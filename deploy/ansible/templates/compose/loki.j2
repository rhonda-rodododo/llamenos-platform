name: llamenos-loki

services:
  loki:
    image: {{ loki_image | default('grafana/loki:3.4.2') }}
    restart: unless-stopped
    volumes:
      - ./loki-config.yml:/etc/loki/local-config.yaml:ro
      - loki-data:/loki
    command: -config.file=/etc/loki/local-config.yaml
    networks:
      - llamenos-observability
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  loki-data:

networks:
  llamenos-observability:
    external: true
