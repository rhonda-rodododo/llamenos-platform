name: llamenos-alertmanager

services:
  alertmanager:
    image: {{ alertmanager_image | default('prom/alertmanager:v0.28.1') }}
    restart: unless-stopped
    volumes:
      - ./alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - alertmanager-data:/alertmanager
    networks:
      - llamenos-observability
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  alertmanager-data:

networks:
  llamenos-observability:
    external: true
