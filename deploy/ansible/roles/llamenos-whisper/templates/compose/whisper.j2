name: llamenos-whisper

services:
  whisper:
    image: {{ llamenos_whisper_image | default('fedirz/faster-whisper-server:0.4.0-cpu@sha256:f77aaf85e2e811aae96a60b04c85ff7cb0e0f2be6729c6fd7600340842412539') }}
    restart: unless-stopped
    environment:
      - WHISPER__MODEL={{ whisper_model | default('Systran/faster-whisper-base') }}
      - WHISPER__DEVICE={{ whisper_device | default('cpu') }}
    networks:
      - llamenos-internal
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  llamenos-internal:
    external: true
