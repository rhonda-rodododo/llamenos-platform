name: llamenos

services:
  app:
    image: {{ llamenos_app_image }}
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /tmp:size=64M
    # All application env vars are rendered once, in one place, by env.j2 ->
    # .env (see roles/llamenos/tasks/main.yml). Previously this list duplicated
    # a subset of that file inline and .env was never actually loaded by
    # Compose (no env_file / no ${VAR} substitution), so any var added only to
    # env.j2 silently never reached the container (issue #716). env_file is
    # the single source of truth now — do not add an `environment:` list back
    # here for the app service.
    env_file:
      - .env
    networks:
      - web
      - internal
    depends_on:
      postgres:
        condition: service_healthy
      rustfs:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"
        tag: "llamenos-app"
    healthcheck:
      test: ["CMD", "bun", "-e", "fetch('http://localhost:3000/api/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s

  postgres:
    image: {{ llamenos_postgres_image | default('postgres:17-alpine') }}
    restart: unless-stopped
    volumes:
      - postgres-data:/var/lib/postgresql/data
    environment:
      - POSTGRES_DB=llamenos
      - POSTGRES_USER=llamenos
      - POSTGRES_PASSWORD={{ pg_password }}
    networks:
      - internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U llamenos -d llamenos"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  caddy:
    image: {{ llamenos_caddy_image | default('caddy:2.9-alpine') }}
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    environment:
      - DOMAIN={{ domain }}
      - ACME_EMAIL={{ acme_email }}
    networks:
      - web
    depends_on:
      app:
        condition: service_healthy

  rustfs:
    image: {{ llamenos_rustfs_image | default('rustfs/rustfs:latest') }}
    command: server /data --console-address ":9001"
    restart: unless-stopped
    volumes:
      - rustfs-data:/data
    environment:
      - RUSTFS_ACCESS_KEY={{ storage_access_key }}
      - RUSTFS_SECRET_KEY={{ storage_secret_key }}
      - RUSTFS_CONSOLE_ENABLE=true
    networks:
      - internal
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:9000/ || test $? -eq 22"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

volumes:
  postgres-data:
  caddy-data:
  caddy-config:
  rustfs-data:

networks:
  web:
    driver: bridge
  internal:
    driver: bridge
    internal: true
