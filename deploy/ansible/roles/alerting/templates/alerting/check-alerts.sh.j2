#!/bin/bash
# Check alerts script — managed by Ansible
# Do not edit manually; changes will be overwritten on next deploy.

set -euo pipefail

APP_DIR="{{ app_dir }}"
source "${APP_DIR}/alerting/alert-functions.sh"

echo "=== Alert Check ==="
echo "Started: $(date -Iseconds)"

# Check app health
APP_HEALTH=$(curl -sf http://localhost:3000/api/health 2>/dev/null || echo "DOWN")
if [ "${APP_HEALTH}" = "DOWN" ]; then
    dispatch_alert "high" "App health check failed"
fi

# Check disk space
USAGE=$(df "${APP_DIR}" | tail -1 | awk '{print $5}' | tr -d '%')
if [ "${USAGE}" -ge "{{ llamenos_alert_disk_percent | default(85) }}" ]; then
    dispatch_alert "high" "Disk usage is ${USAGE}%"
fi

echo "Completed: $(date -Iseconds)"
