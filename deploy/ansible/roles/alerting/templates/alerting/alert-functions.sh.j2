#!/bin/bash
# Alert functions — managed by Ansible
# Do not edit manually; changes will be overwritten on next deploy.

set -euo pipefail

# Send alert via ntfy
send_ntfy_alert() {
    local topic="${1}"
    local message="${2}"
    local priority="${3:-default}"
    
    curl -s -X POST "https://ntfy.sh/${topic}" \
        -H "Priority: ${priority}" \
        -d "${message}" 2>/dev/null || true
}

# Send alert via webhook
send_webhook_alert() {
    local url="${1}"
    local message="${2}"
    
    curl -s -X POST "${url}" \
        -H "Content-Type: application/json" \
        -d "{\"message\": \"${message}\"}" 2>/dev/null || true
}

# Main alert dispatcher
dispatch_alert() {
    local severity="${1}"
    local message="${2}"
    
    echo "[${severity}] ${message}"
    
    {% if alert_ntfy_topic is defined %}
    send_ntfy_alert "{{ alert_ntfy_topic }}" "${message}" "${severity}"
    {% endif %}
    
    {% if alert_webhook_url is defined and alert_webhook_url %}
    send_webhook_alert "{{ alert_webhook_url }}" "${message}"
    {% endif %}
}
