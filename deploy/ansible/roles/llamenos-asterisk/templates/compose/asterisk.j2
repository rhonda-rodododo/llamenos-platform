name: llamenos-asterisk

services:
  asterisk:
    image: {{ llamenos_asterisk_image | default('andrius/asterisk:latest') }}
    restart: unless-stopped
    volumes:
      - ./asterisk-config:/etc/asterisk:ro
    networks:
      - llamenos-internal
    healthcheck:
      test: ["CMD", "asterisk", "-rx", "core show version"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  llamenos-internal:
    external: true
