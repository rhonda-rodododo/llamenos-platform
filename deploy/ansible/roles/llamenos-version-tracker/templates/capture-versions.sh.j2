#!/bin/bash
# Version capture script — managed by Ansible
# Do not edit manually; changes will be overwritten on next deploy.

set -euo pipefail

APP_DIR="{{ app_dir }}"
VERSION_FILE="${APP_DIR}/.version-history/current.json"
HISTORY_FILE="${APP_DIR}/.version-history/history.json"

echo "=== Capture Versions ==="
echo "Started: $(date -Iseconds)"

# Get current versions
APP_VERSION=$(docker inspect --format='{{ '{{' }}.RepoTags{{ '}}' }}' $(docker compose -f "${APP_DIR}/services/app/docker-compose.yml" ps -q app 2>/dev/null) 2>/dev/null || echo "unknown")
POSTGRES_VERSION=$(docker inspect --format='{{ '{{' }}.RepoTags{{ '}}' }}' $(docker compose -f "${APP_DIR}/services/postgres/docker-compose.yml" ps -q postgres 2>/dev/null) 2>/dev/null || echo "unknown")

cat > "${VERSION_FILE}" << EOF
{
  "timestamp": "$(date -Iseconds)",
  "app": "${APP_VERSION}",
  "postgres": "${POSTGRES_VERSION}"
}
EOF

echo "Versions captured"
