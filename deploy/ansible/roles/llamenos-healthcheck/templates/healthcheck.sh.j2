#!/bin/bash
# Healthcheck script — managed by Ansible
# Do not edit manually; changes will be overwritten on next deploy.

set -euo pipefail

ENDPOINTS=(
  "app:http://app:3000/api/health"
  "postgres:tcp://postgres:5432"
)

FAILED=0

for endpoint in "${ENDPOINTS[@]}"; do
  name="${endpoint%%:*}"
  url="${endpoint#*:}"
  
  if [[ "${url}" == tcp://* ]]; then
    hostport="${url#tcp://}"
    if timeout 5 bash -c ">/dev/tcp/${hostport%/*}/${hostport#*/}" 2>/dev/null; then
      echo "OK: ${name}"
    else
      echo "FAIL: ${name}"
      FAILED=1
    fi
  else
    if curl -sf "${url}" >/dev/null 2>&1; then
      echo "OK: ${name}"
    else
      echo "FAIL: ${name}"
      FAILED=1
    fi
  fi
done

if [ "${FAILED}" -ne 0 ]; then
  echo "Health check failed"
  exit 1
fi

echo "All health checks passed"
