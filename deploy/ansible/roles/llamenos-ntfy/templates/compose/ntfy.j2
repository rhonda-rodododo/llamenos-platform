name: llamenos-ntfy

services:
  ntfy:
{{ lookup('ansible.builtin.template', playbook_dir ~ '/../roles/llamenos-ntfy/templates/compose/_ntfy-service.j2') | indent(4, first=true) }}
    ports:
      # Loopback-only — for the local health check and `ntfy` CLI
      # provisioning tasks. Public/Android traffic reaches this
      # container via Caddy on the llamenos-web network, never this port.
      - "127.0.0.1:{{ llamenos_ntfy_local_port }}:80"
    networks:
      # llamenos-internal: reachable by the app container at NTFY_URL=http://ntfy:80
      # llamenos-web: reachable by Caddy for the public ntfy_domain vhost
      - llamenos-internal
      - llamenos-web

volumes:
  ntfy-data:

networks:
  llamenos-internal:
    external: true
  llamenos-web:
    external: true
