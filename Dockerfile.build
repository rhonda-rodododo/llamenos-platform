# Dockerfile.build — Canonical build environment for reproducible builds (Epic 79)
#
# This container produces deterministic output given the same source code.
# All verification builds MUST use this container (not bare metal) to ensure
# consistent Tailwind CSS ordering and build tool behavior.
#
# Usage:
#   docker build -f Dockerfile.build -t llamenos-build .
#   docker create --name extract llamenos-build
#   docker cp extract:/build/dist ./dist
#   docker rm extract
#
# CI sets SOURCE_DATE_EPOCH from git commit time for deterministic timestamps.
# Local builds default to epoch 0 (1970-01-01) for full reproducibility.

FROM oven/bun:1@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4

# Consistent locale (prevents locale-dependent output differences)
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Remove variable environment
ENV HOME=/build
ENV USER=build

# Default SOURCE_DATE_EPOCH for local builds (CI overrides via --build-arg)
ARG SOURCE_DATE_EPOCH=0
ARG GITHUB_SHA=local
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
ENV GITHUB_SHA=${GITHUB_SHA}

WORKDIR /build

# Install dependencies first (layer caching)
# Copy workspace package.json files so bun can resolve the lockfile.
# packages/shared has no package.json — bun's workspace glob skips
# directories without one, so it doesn't need a stub.
COPY package.json bun.lockb ./
COPY site/package.json site/
COPY apps/worker/package.json apps/worker/
COPY packages/crypto/package.json packages/crypto/
COPY packages/i18n/package.json packages/i18n/
COPY packages/protocol/package.json packages/protocol/
COPY packages/test-specs/package.json packages/test-specs/
RUN bun install --frozen-lockfile --ignore-scripts

# Copy source and workspace packages (Vite aliases resolve to ./packages/*)
COPY src/ src/
COPY public/ public/
COPY index.html vite.config.ts tsconfig.json ./
COPY tailwind.config.ts* ./
COPY apps/worker/ apps/worker/
COPY packages/shared/ packages/shared/
COPY packages/crypto/ffi.ts packages/crypto/ffi.ts
COPY packages/i18n/ packages/i18n/
COPY packages/protocol/ packages/protocol/

# Build frontend (Vite) — reads SOURCE_DATE_EPOCH and GITHUB_SHA
RUN bun run build

# Build server for reproducibility (Bun build with bytecode)
RUN bun build src/server/index.ts --target=bun --outdir=dist/server --sourcemap

# Output: /build/dist/client/ and /build/dist/server/
